# "waitlist" (default) muestra la lista de espera en "/"; "launch" muestra
# la venta en "/" y mueve la waitlist a "/lista".
NEXT_PUBLIC_PHASE=waitlist

# URL productiva, usada para metadataBase/sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://academiamerlo.com

# ID del formulario publicado en Tally (Share > Embed). Vacío = maqueta
# local del formulario, sin enviar datos. El form real (aQ8N92) está en
# DRAFT hasta que se publique desde la cuenta de Tally.
NEXT_PUBLIC_TALLY_FORM_ID=

# "on" activa reveals/stagger/count-up al hacer scroll (detrás de un flag
# para decidir con el equipo antes de prenderlo). Por defecto apagado.
NEXT_PUBLIC_MOTION=off

# Links de checkout de Hotmart por plan. Vacíos = los botones de planes
# muestran el estado "pendiente" (sin link real todavía).
NEXT_PUBLIC_HOTMART_CHECKOUT_STANDARD=
NEXT_PUBLIC_HOTMART_CHECKOUT_VIP=
